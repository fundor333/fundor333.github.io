# Normalise line endings
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

# Vendored minified libraries: treat as generated, don't diff or linguist them
assets/js/vendor/*.js -diff linguist-vendored

# Keep exampleSite and images out of the module archive downloaded by consumers
exampleSite/** export-ignore
images/** export-ignore
.github/** export-ignore

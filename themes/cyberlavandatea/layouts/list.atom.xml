{{- $pages := .RegularPages -}}
{{- if .IsHome }}{{ $pages = where site.RegularPages "Type" "in" (site.Params.feedSections | default (slice "post")) }}{{ end -}}
{{- $pages = where $pages "Params.exclude_from_rss" "!=" true -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 }}{{ $pages = $pages | first $limit }}{{ end -}}
{{- $fmt := "2006-01-02T15:04:05Z07:00" -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:webfeeds="http://webfeeds.org/rss/1.0">
  <title>{{ site.Title }}</title>
  <subtitle>{{ site.Params.description }}</subtitle>
  <id>{{ with site.Params.feedUUID }}urn:uuid:{{ . }}{{ else }}{{ .Permalink }}{{ end }}</id>
  <updated>{{ now.Format $fmt | safeHTML }}</updated>
  <link href="{{ .Permalink }}"/>
  {{ with .OutputFormats.Get "atom" }}{{ printf `<link rel="self" type="%s" href="%s"/>` .MediaType.Type .Permalink | safeHTML }}{{ end }}
  {{ with site.Params.author.name }}<author><name>{{ . }}</name><uri>{{ site.BaseURL }}</uri></author>{{ end }}
  {{ with site.Params.logo }}<logo>{{ . | absURL }}</logo>{{ end }}
  {{ with site.Params.icon }}<icon>{{ . | absURL }}</icon><webfeeds:icon>{{ . | absURL }}</webfeeds:icon>{{ end }}
  {{ with site.Copyright }}<rights>{{ replace . "{year}" now.Year }}</rights>{{ end }}
  {{ range $pages }}
  <entry>
    <title>{{ .Title }}</title>
    <id>tag:{{ (urls.Parse .Permalink).Host }},{{ .Date.Format "2006-01-02" }}:{{ .RelPermalink }}</id>
    <link rel="alternate" href="{{ .Permalink }}"/>
    <published>{{ .Date.Format $fmt | safeHTML }}</published>
    <updated>{{ .Lastmod.Format $fmt | safeHTML }}</updated>
    {{ with .Params.author | default site.Params.author.name }}<author><name>{{ . }}</name></author>{{ end }}
    {{ range .Params.tags }}<category term="{{ . }}"/>{{ end }}
    {{ with .Description }}<summary type="text">{{ . }}</summary>{{ end }}
    <content type="html" xml:base="{{ .Permalink }}">{{ printf "<![CDATA[%s]]>" .Content | safeHTML }}</content>
  </entry>
  {{ end }}
</feed>

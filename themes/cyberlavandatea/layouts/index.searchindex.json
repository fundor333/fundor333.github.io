{{- $df := site.Params.dateFormat | default "2 Jan 2006" -}}
{{- $docs := slice -}}
{{- range where site.RegularPages "Params.exclude_from_search" "!=" true -}}
  {{- $docs = $docs | append (dict
      "uri" .RelPermalink
      "title" .Title
      "date" (.Date | time.Format $df)
      "description" (.Description | default "")
      "tags" (.Params.tags | default slice)
      "categories" (.Params.categories | default slice)
      "content" (.Plain | htmlUnescape)
  ) -}}
{{- end -}}
{{- $docs | jsonify -}}
